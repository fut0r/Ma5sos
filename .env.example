# ==============================================================================
# إعدادات بيئة العمل لمنصة مخصوص (Ma5sos Environment Settings)
# انسخ هذا الملف إلى .env.local واملأ المتغيرات دون مشاركتها أو رفعها إلى Git.
# ==============================================================================

# ---------- قاعدة البيانات (Neon PostgreSQL Database) ----------
# انسخ رابط الاتصال من لوحة تحكم Neon (مع معيار sslmode=require للاتصال الآمن).
# مثال: postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
# في بيئة التطوير المحلية دون وجود Neon، يتم تلقائياً استخدام SQLite كبديل محلي آمن.
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
# رابط الاتصال المباشر (بدون -pooler) يُستخدم فقط لإنشاء الجداول والترحيلات.
# Neon CLI يضيف هذا المتغير تلقائياً عند تنفيذ neon deploy.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# ---------- الأمان والمصادقة (JWT & Security) ----------
# مفتاح سري عشوائي طويل لتشفير وتوقيع رموز الجلسات (JWT Tokens).
JWT_SECRET=your-long-secure-random-secret-key-here-change-in-production

# حساب المسؤول الأولي (Initial Admin Account Setup)
# يُنشأ الحساب تلقائيًا عند بدء التشغيل إذا كانت قاعدة البيانات فارغة.
ADMIN_EMAIL=admin@ma5sos.com
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere!
ADMIN_NAME=مدير مخصوص

# ---------- إعدادات الموقع والنطاق (Site Configuration) ----------
# العنوان العام للموقع المباشر (Production URL)
SITE_URL=https://www.ma5sos.com

# منفذ خادم FastAPI في بيئة التطوير المحلي
API_PORT=8000

# بيئة التشغيل (development | production)
NODE_ENV=production

# ---------- بوابة الدفع Paylink (اختياري) ----------
# mock: دفع تجريبي محلي | production: دفع حقيقي عبر مفاتيح Paylink الخاصة بك
PAYLINK_ENV=mock
PAYLINK_API_ID=
PAYLINK_SECRET_KEY=
PAYLINK_WEBHOOK_TOKEN=

# ---------- Firebase Phone Authentication ----------
# The web config below is public (it ships in the browser bundle). The
# project id is used by the API to verify Firebase phone ID tokens.
FIREBASE_PROJECT_ID=mazom-8ce99
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
